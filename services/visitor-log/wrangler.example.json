{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xh-diary-visitor-log",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://xh-diary.me,https://www.xh-diary.me",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xh-diary-visits",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "COLLECT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": false }
}
