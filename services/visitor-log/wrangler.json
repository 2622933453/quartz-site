{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xh-diary-visitor-log",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://xh-diary.me,https://www.xh-diary.me",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xh-diary-visits",
      "database_id": "12df444e-eda8-44a8-857a-6bebeae43eeb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "COLLECT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 19 * * *"]
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "visits.xh-diary.me",
      "custom_domain": true
    }
  ],
  "account_id": "569f77ce69b2011566ed27d88f58a5b7"
}
